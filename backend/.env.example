# TRIBE on Mac: CUDA is not available. Use default auto (uses Apple GPU / MPS on Apple Silicon) or TRIBE_DEVICE=cpu.
TRIBE_DEVICE=auto

# Allow POST /api/video/import-result/{id} for Colab-exported JSON (disable in production)
ALLOW_ANALYSIS_IMPORT=0

# Kimi / Moonshot (OpenAI-compatible). kimi-k2.5 is the recommended multimodal model
# when you want low-engagement feedback to include a screenshot plus transcript context.
MOONSHOT_API_KEY=
MOONSHOT_MODEL=kimi-k2.5
MOONSHOT_BASE_URL=https://api.moonshot.cn/v1

# Anthropic (optional if using Moonshot above)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-20250514
